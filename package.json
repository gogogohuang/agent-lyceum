{
  "name": "agent-lyceum",
  "version": "0.4.10",
  "description": "Config + dispatcher for teams of Claude Code / Codex agents with scoped context and file-based mailboxes",
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "claude-code",
    "codex",
    "cli",
    "mailbox"
  ],
  "author": "Jin-Ze Huang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gogogohuang/agent-lyceum.git"
  },
  "homepage": "https://github.com/gogogohuang/agent-lyceum#readme",
  "bugs": {
    "url": "https://github.com/gogogohuang/agent-lyceum/issues"
  },
  "type": "module",
  "bin": {
    "agent-lyceum": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
