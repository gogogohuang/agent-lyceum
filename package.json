{
  "name": "agent-lyceum",
  "version": "0.4.15",
  "description": "Config + dispatcher for teams of Claude Code / Codex agents with scoped context and file-based mailboxes",
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "claude-code",
    "codex",
    "cli",
    "mailbox"
  ],
  "author": "Jin-Ze Huang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gogogohuang/agent-lyceum.git"
  },
  "homepage": "https://github.com/gogogohuang/agent-lyceum#readme",
  "bugs": {
    "url": "https://github.com/gogogohuang/agent-lyceum/issues"
  },
  "type": "module",
  "bin": {
    "agent-lyceum": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:plugin",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "bash scripts/release.sh",
    "typecheck:plugin": "tsc -p plugins/status-monitor/tsconfig.ci.json",
    "check:pack": "node scripts/check-pack.mjs",
    "lint": "biome lint"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "yaml": "^2.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
