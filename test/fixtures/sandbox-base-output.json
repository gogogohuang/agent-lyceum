  "exec",
  "resume",
  "sid",
  "-c",
  "sandbox_mode=\"workspace-write\"",
  "-c",
  "approval_policy=\"never\"",
  "-c",
  "sandbox_workspace_write.writable_roots=[\"<ROOT>/home/agents/fe-member/memory\",\"<ROOT>/home/projects/demo/shared/outbox/fe-member\",\"<ROOT>/home/projects/demo/agents/fe-member\",\"<ROOT>/home/projects/demo/shared/common\"]",
